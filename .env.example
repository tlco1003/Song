# SONG: OpenAI GPT lyric writing + official Suno MCP music generation
# Never commit live .env files, OAuth credentials, or user recordings.
OPENAI_API_KEY=
# Model identifier can be changed to any model available to your OpenAI API project.
OPENAI_LYRICS_MODEL=gpt-6-astra
OPENAI_SUNO_MODEL=gpt-6-astra
# The following must be obtained through a legitimate Suno OAuth flow.
# A paid Suno plan / ChatGPT or Claude connector login alone does NOT fill this key.
# Private single-owner development only: never reuse one person's token for public multi-user SaaS.
SUNO_MCP_ACCESS_TOKEN=
# Required for access to the credit-spending /api/suno-mcp/create endpoint.
APP_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=3000

# -------------------------------------------------------------------
# Future WITHU paid-order / operator handoff integration only.
# These variables are NOT sufficient to enable public payment processing.
# Never place real values in GitHub, browser JS, GitHub Pages or commits.
# A durable DB, authenticated HTTP routes, PG verification, and B2B
# music licensing must be implemented and verified before enabling charge.
# -------------------------------------------------------------------
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
DATABASE_URL=
RESEND_API_KEY=
WITHU_FROM_EMAIL=
WITHU_OPERATOR_EMAIL=
# This switch is documentation only. It must NOT bypass hardcoded commerce readiness.
WITHU_FULFILLMENT_PREFERENCE=manual_operator

# -------------------------------------------------------------------
# WITHU customer-delivery channels (server only — NEVER frontend files)
# The registered phone and approved Kakao Alimtalk sender/template are
# required before accepting SMS / Kakao notification jobs.
# Authorization is the exact Bizgo API authorization header value
# obtained from your Bizgo account. No fake keys / fallback-to-free.
# -------------------------------------------------------------------
WITHU_PUBLIC_BASE_URL=
WITHU_BIZGO_AUTHORIZATION=
WITHU_BIZGO_SMS_SENDER=
WITHU_BIZGO_KAKAO_SENDER_KEY=
WITHU_BIZGO_KAKAO_TEMPLATE_CODE=
WITHU_BIZGO_KAKAO_TEMPLATE_TEXT=

# -------------------------------------------------------------------
# LOCAL DEV ONLY. Never set these in Firebase, GitHub Pages or production.
# Test simulation MUST use HOST=127.0.0.1 and NODE_ENV != production.
# This is NOT a PG test key; real payments are never simulated as genuine.
# Run: npm run staging
# -------------------------------------------------------------------
WITHU_STAGING_ENABLED=false
WITHU_STAGING_ADMIN_KEY=
WITHU_PRIVATE_MUSIC_DIR=

# Resend signed delivery/failed/bounced webhooks (server only)
RESEND_WEBHOOK_SIGNING_SECRET=

# Post-PG verified manual music alert: email | sms | both
WITHU_OPERATOR_ALERT_CHANNEL=email
WITHU_OPERATOR_PHONE=
