# Copy to .env and fill in your own API keys. Never commit .env.
# Only needed when requesting AI-written lyrics (the Suno copy handoff itself is free).
GEMINI_API_KEY=
# Existing 30-second Lyria/ElevenLabs prototype is disabled by default.
# Keep false in the Suno-first product; enable only for isolated legacy experiments.
LEGACY_LYRIA_ENABLED=false
ELEVENLABS_API_KEY=
# Suno has an official REST platform, but customer-facing access and authenticated API schema
# must be obtained directly from Suno before implementing automated calls.
# No unofficial "Suno API" or session cookies should be stored here.
# APP_ACCESS_TOKEN is required if HOST is non-loopback; NOT a substitute for per-user auth.
APP_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=3000
# Number of minutes locally generated assets are retained. Vendor retention is separate.
ASSET_TTL_MINUTES=60
