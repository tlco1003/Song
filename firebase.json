{
  "functions": [
    {
      "source": ".",
      "codebase": "withu",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "docs/media",
        "docs/covers",
        "docs/reviews",
        "*.log",
        ".env",
        ".env.*",
        ".firebase",
        ".github"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "docs",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md"
    ]
  }
}
