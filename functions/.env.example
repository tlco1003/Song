# Copy to functions/.env (do not commit). These are NONSECRET deployment settings.
WITHU_PUBLIC_BASE_URL=https://YOUR_FIREBASE_HOSTING_DOMAIN/
WITHU_PAYMENT_MODE=test
# Set live only after test payments, merchant approval and policies are verified.
# WITHU_PAYMENT_MODE=live
# WITHU_LIVE_PAYMENTS_ENABLED=true
WITHU_LIVE_PAYMENTS_ENABLED=false
TOSS_CLIENT_KEY=test_gck_REPLACE_FROM_TOSS_DEVELOPER_CENTER
WITHU_OPERATOR_EMAIL=YOUR_VERIFIED_OPERATOR_EMAIL
WITHU_ADMIN_UID=YOUR_FIREBASE_AUTH_ADMIN_UID
WITHU_FROM_EMAIL=WITHU <music@YOUR_VERIFIED_DOMAIN>
WITHU_FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
WITHU_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
WITHU_FIREBASE_PROJECT_ID=YOUR_PROJECT
WITHU_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
WITHU_ALLOW_SHARE=true

# REQUIRED: server-side encryption and email/AI/PG credentials are Firebase Secrets
# and must NOT be stored in this file or GitHub.
# firebase functions:secrets:set TOSS_SECRET_KEY
# firebase functions:secrets:set RESEND_API_KEY
# firebase functions:secrets:set WITHU_LINK_ENCRYPTION_KEY
# firebase functions:secrets:set OPENAI_API_KEY
# Link key must be exactly 64 hex characters (openssl rand -hex 32).
# Choose a valid licensed OpenAI API text model, not a consumer ChatGPT plan.
OPENAI_LYRICS_MODEL=gpt-4.1

# Required secret for server-verified Resend sent/delivered/bounced status
# firebase functions:secrets:set RESEND_WEBHOOK_SIGNING_SECRET

# Optional private SONG AI automation; without this the admin screen still supports
# owner uploads and manually reviewed timing, but automated Demucs/ASR is unavailable.
# The Cloud Run JOB is a separately deployed PRIVATE Python image, not a website.
# WITHU_TIMING_CLOUD_RUN_JOB=projects/YOUR_PROJECT/locations/asia-northeast3/jobs/withu-song-timing
# Grant the Firebase Functions service account Cloud Run Jobs run-with-overrides;
# grant the private Job service account access only to required Firestore/GCS data.

# Optional official Google Lyria 3.5 music generation after verified payment.
# DISABLED unless the exact provider name, private approved rights record,
# verified paid order and GEMINI_API_KEY secret ALL exist.
# Google terms for paid customer song delivery MUST be independently cleared.
# WITHU_AUTOMATED_MUSIC_PROVIDER=google_lyria
# firebase functions:secrets:set GEMINI_API_KEY
# Private Firestore gate (operator reviewed):
# withuProviderApprovals/google_lyria = {
#  providerId: google_lyria, model: lyria-3.5, status: approved,
#  verifiedByUid: WITHU_ADMIN_UID, verifiedAt: <epoch_ms>,
#  validUntil: <epoch_ms>, allowedUseCases: [customer_specific_paid_music_delivery],
#  privateEvidenceRef: private/legal/<rights-evidence-id>
# }
# Rights evidence MUST NOT be put into this public repository.

# OPTIONAL: Google Drive PRIVATE backup after GCS storage.
# Shared Drive folder (Google Workspace) with service-account access only.
# Personal Google Drive folders do not support direct service-account ownership.
# WITHU_DRIVE_BACKUP_ENABLED=true
# WITHU_DRIVE_FOLDER_ID=RESTRICTED_SHARED_DRIVE_FOLDER_ID
# firebase functions:secrets:set WITHU_DRIVE_SERVICE_ACCOUNT_JSON
# Never create public anyone-with-link sharing for customer media.

# Optional one-Google-key provider for lyrics + artist research + Lyria music.
# Disabled by default: existing OpenAI lyrics remains the fallback.
# WITHU_LYRICS_PROVIDER=gemini
# WITHU_GEMINI_LYRICS_MODEL=gemini-3.6-flash
# Google Search grounding is billed per search query. Disabled by default.
# WITHU_ARTIST_RESEARCH_ENABLED=true
# Source-linked artist research is an UNAPPROVED candidate until operator review.
# Real source-reviewed artist observations go into the restricted
# WITHU_PRIVATE_STYLE_DIR/artist-references directory, never this public git.

# OFFICIAL MUREKA API — optional main music provider (purchased API credits).
# Initial API setup: https://platform.mureka.ai/ (Dashboard -> API Keys).
# Create Secret interactively; NEVER paste key into files/HTML/GitHub/Chat:
# firebase functions:secrets:set MUREKA_API_KEY
# For single Mureka key for BOTH private lyric and music generation:
# WITHU_LYRICS_PROVIDER=mureka
# WITHU_AUTOMATED_MUSIC_PROVIDER=mureka
# Existing OpenAI/Gemini lyrics and official Google Lyria music stay optional.
# Mureka songs are asynchronous. Cloud Scheduler automatically polls every 2m
# from PRIVATE Firestore. Firebase billing, Functions and Scheduler deployment
# are required. Scheduler NEVER resubmits a billed music generation POST.
# Critical: derive actual signed CDN host from your first authorized Mureka
# API query result, VERIFY vendor ownership, then configure exact hostname(s):
# WITHU_MUREKA_AUDIO_HOST_ALLOWLIST=YOUR_VERIFIED_MUREKA_AUDIO_CDN_HOST
# Do not allow arbitrary URL hosts/0.0.0.0 or add wildcards; fail closed.
# Production rights gate (operator-reviewed private Firestore record):
# withuProviderApprovals/mureka = {
#  providerId: mureka, model: mureka-9.5, status: approved,
#  verifiedByUid: WITHU_ADMIN_UID, verifiedAt: <epoch_ms>,
#  validUntil: <epoch_ms>, allowedUseCases: [customer_specific_paid_music_delivery],
#  privateEvidenceRef: private/legal/<verified-mureka-api-license-evidence>
# }
# Verify the paid account's commercial rights and SONG AI terms before approval.
# Authenticated admin-only read-only API diagnostic (does not use credits):
# GET /api/admin/providers/mureka/account
